# VyapariMitra AI Backend Configuration
# ====================================

# Application Environment
ENVIRONMENT=development
PROJECT_NAME="VyapariMitra AI"
API_V1_STR="/api/v1"
SECRET_KEY="vyaparimitra-ultra-secure-jwt-secret-key-change-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (SQLite default for zero-friction local setup, PostgreSQL supported)
DATABASE_URL="sqlite+aiosqlite:///./vyaparimitra.db"

# Gnani AI API Credentials
# Obtain your API key from https://app.gnani.ai/voice
GNANI_API_KEY=""
GNANI_API_BASE_URL="https://api.vachana.ai"
GNANI_STT_ENDPOINT="https://api.vachana.ai/stt/v3"
GNANI_TTS_ENDPOINT="https://api.vachana.ai/api/v1/tts/inference"

# STT & TTS Defaults
GNANI_STT_DEFAULT_MODEL="prisma-v3.0"
GNANI_STT_DEFAULT_LANG="te-IN"
GNANI_TTS_DEFAULT_MODEL="timbre-v2.5"
GNANI_TTS_DEFAULT_VOICE="Nalini"

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000"]
